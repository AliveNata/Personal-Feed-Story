# Copy to backend/.env. Never commit the real file.

# TikTok cookie from a logged in browser session (secondary account recommended).
TIKTOK_COOKIE=
TIKTOK_LOOKBACK_DAYS=30

# Instagram session created with: instaloader --login <IG_USERNAME> --sessionfile backend/secrets/ig-session
# Leave both empty to run anonymous (posts only, no stories, tight rate limit).
IG_USERNAME=
IG_SESSION_FILE=/app/secrets/ig-session
IG_INCLUDE_STORIES=true

CACHE_TTL_SECONDS=900
DEFAULT_POST_LIMIT=12
CORS_ORIGINS=["http://localhost:5173"]
