# Copy to backend/.env. Never commit the real file.

# TikTok cookie from a logged in browser session (secondary account recommended).
TIKTOK_COOKIE=
TIKTOK_LOOKBACK_DAYS=30

# Instagram session for stories and highlights. Create it with the ig-session CLI (README step 5).
# Leave both empty to run anonymous (posts only, no stories, tight rate limit).
IG_USERNAME=
IG_SESSION_FILE=/app/secrets/ig-session
IG_INCLUDE_STORIES=true

DEFAULT_POST_LIMIT=12
CORS_ORIGINS=["http://localhost:5173"]

# Download library. Files live in ./data/library on the host.
# Random pause (seconds) between posts in a download job, lower bound and upper bound.
INSTAGRAM_DELAY_SECONDS=[4, 9]
TIKTOK_DELAY_SECONDS=[1, 3]
MAX_POSTS_PER_JOB=50
# ZIP/RAR uploads: archive size, and total size once unpacked (bytes).
MAX_ARCHIVE_BYTES=2147483648
MAX_ARCHIVE_UNPACKED_BYTES=4294967296
# Request budget per platform: [max requests, window in seconds]. Our own conservative guesses.
INSTAGRAM_RATE_BUDGET=[100, 900]
# Logged out requests for public Instagram posts, counted per server IP, not per account.
INSTAGRAM_ANON_RATE_BUDGET=[60, 900]
TIKTOK_RATE_BUDGET=[150, 900]
# Lossy and off by default. Turn on when disk space matters more than original quality.
COMPRESS_PHOTOS=false
PHOTO_WEBP_QUALITY=82
# H.265 plays in Safari and Chrome/Edge with hardware support, not in Firefox.
TRANSCODE_VIDEOS=false
VIDEO_CRF=28

# Set true once served over https (VPS).
SESSION_COOKIE_SECURE=false
